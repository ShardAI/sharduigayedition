local passed = 0
local function test(name, callback)
    local ok, message = pcall(callback)
    assert(ok, name .. ': ' .. tostring(message))
    passed += 1
    print('PASS ' .. name)
end
local function source()
    local pixels = buffer.create(16 * 16 * 4)
    for y = 0, 15 do for x = 0, 15 do
        local offset = (y * 16 + x) * 4
        buffer.writeu8(pixels, offset, x * 17)
        buffer.writeu8(pixels, offset + 1, y * 17)
        buffer.writeu8(pixels, offset + 2, 100)
        buffer.writeu8(pixels, offset + 3, 255)
    end end
    return {Pixels = pixels, Width = 16, Height = 16, Origin = Vector2.zero,
        Size = Vector2.new(500, 500), ExcludesGlass = true, Opaque = true}
end
local function setup(options)
    local root = Instance.new('ScreenGui')
    local manager = Glass.newManager(root, options or {TileSize = 16, MaxSurfaces = 4})
    return root, manager
end
local function frame(root, x, y, w, h)
    local object = Instance.new('Frame')
    object.AbsolutePosition = Vector2.new(x or 0, y or 0)
    object.AbsoluteSize = Vector2.new(w or 100, h or 100)
    object.Parent = root
    return object
end
test('source validation rejects feedback, corrupt buffers, NaN and invalid coordinates', function()
    local s = source()
    assert(Glass.ValidateSource(s))
    s.ExcludesGlass = false; assert(not Glass.ValidateSource(s)); s.ExcludesGlass = true
    s.Width = 0/0; assert(not Glass.ValidateSource(s)); s.Width = 16
    s.Size = Vector2.new(0, 1); assert(not Glass.ValidateSource(s)); s.Size = Vector2.new(1, 1)
    s.Pixels = buffer.create(3); assert(not Glass.ValidateSource(s))
end)
test('rounded silhouette clamps radius and has correct signed distances', function()
    assert(Glass.Distance(50, 50, 100, 100, 9999) == -50)
    assert(Glass.Distance(0, 0, 100, 100, 20) > 0)
    assert(Glass.Distance(50, 0, 100, 100, 20) == 0)
end)
test('optics change bezel pixels, preserve center, leave gutters and corners transparent', function()
    local s = source()
    local a, b = buffer.create(64*64*4), buffer.create(64*64*4)
    local style = {Radius = 50, Bezel = 20, Refraction = 0, Blur = 0, Opacity = 1,
        Tint = Color3.new(1,1,1), TintStrength = 0}
    local rect = {X = 0, Y = 0, Width = 500, Height = 500}
    Glass.RenderTile(a, 64, 0, 0, 64, s, rect, style)
    style.Refraction = 40
    Glass.RenderTile(b, 64, 0, 0, 64, s, rect, style)
    assert(buffer.readu32(a, 0) == 0)
    assert(buffer.readu8(a, (1*64+1)*4+3) == 0)
    assert(buffer.readu32(a, (32*64+32)*4) == buffer.readu32(b, (32*64+32)*4))
    assert(buffer.readu32(a, (32*64+1)*4) ~= buffer.readu32(b, (32*64+1)*4))
end)
test('no provider allocates no image and detach restores owned properties', function()
    local root, manager = setup()
    local object = frame(root)
    local start = assets.Allocations
    manager:Attach(object); manager:Step()
    assert(assets.Allocations == start)
    assert(object.BackgroundTransparency == 0.72)
    manager:Detach(object)
    assert(object.BackgroundTransparency == 0 and object.BorderSizePixel == 1)
    assert(#object:GetChildren() == 0)
    manager:Destroy()
end)
test('two disjoint lenses share one allocation and one write per step', function()
    local root, manager = setup()
    local a, b = frame(root), frame(root, 200)
    manager:Attach(a); manager:Attach(b)
    manager:SetSourceProvider(source)
    local allocations, writes = assets.Allocations, assets.Writes
    manager:Step()
    assert(assets.Allocations == allocations + 1 and assets.Writes == writes + 1)
    assert(manager:GetStatus().RenderedSurfaces == 2)
    manager:Step(); assert(assets.Allocations == allocations + 1 and assets.Writes == writes + 2)
    manager:Destroy()
end)
test('nested and partially overlapping lenses never get a second optical pass', function()
    local root, manager = setup()
    local a = frame(root)
    local b, c = frame(a, 10, 10, 50, 50), frame(root, 90, 0, 100, 100)
    c.ZIndex = 2
    manager:Attach(a); manager:Attach(b); manager:Attach(c)
    manager:SetSourceProvider(source); manager:Step()
    assert(manager:GetStatus().RenderedSurfaces == 1)
    assert(b:GetAttribute('LiquidGlassMode') == 'Overlay')
    assert(c:GetAttribute('LiquidGlassMode') == 'Overlay')
    assert(manager.ByObject[b].Stroke and manager.ByObject[c].Stroke)
    manager:Destroy()
end)
test('hidden ancestors, rotation, layout changes and Global sorting hide stale optics', function()
    local root, manager = setup()
    local parent = frame(root)
    local object = frame(parent)
    manager:Attach(object); manager:SetSourceProvider(source); manager:Step()
    local image = manager.ByObject[object].Image
    assert(image.Visible)
    parent.Visible = false; manager:Step(); assert(not image.Visible)
    parent.Visible = true; object.AbsoluteRotation = 15; manager:Step(); assert(not image.Visible)
    object.AbsoluteRotation = 0
    local layout = Instance.new('UIListLayout'); layout.Parent = object
    manager:Step(); assert(not image.Visible)
    layout:Destroy(); root.ZIndexBehavior = 'Global'; manager:Step(); assert(not image.Visible)
    manager:Destroy()
end)
test('missing image budget does not cause repeated allocations and can retry explicitly', function()
    local root, manager = setup()
    manager:Attach(frame(root)); manager:SetSourceProvider(source)
    assets.Deny = true
    local count = assets.Allocations
    manager:Step(); manager:Step()
    assert(assets.Allocations == count + 1)
    assert(manager:GetStatus().Mode == 'EditableImageUnavailable')
    assets.Deny = false; manager:SetSourceProvider(source); manager:Step()
    assert(manager:GetStatus().Mode == 'SourceRefraction')
    manager:Destroy()
end)
test('provider nil, failure and yield cannot leave a frozen background', function()
    local root, manager = setup()
    local object = frame(root)
    manager:Attach(object); manager:SetSourceProvider(source); manager:Step()
    local image = manager.ByObject[object].Image
    manager:SetSourceProvider(function() return nil end); manager:Step(); assert(not image.Visible)
    manager:SetSourceProvider(function() error('broken source') end)
    heartbeat:Fire(1)
    assert(manager:GetStatus().Mode == 'RendererError' and not image.Visible)
    manager:SetSourceProvider(function() coroutine.yield() end)
    heartbeat:Fire(1)
    assert(manager:GetStatus().Mode == 'RendererError' and not image.Visible)
    manager:Destroy()
end)
test('destruction, source removal, missing UIShadow and repeated cleanup are safe', function()
    Instance.NoShadow = true
    local root, manager = setup()
    local object = frame(root)
    manager:Attach(object); manager:SetSourceProvider(source); manager:Step()
    assert(manager.ByObject[object].Shadow == nil)
    manager:SetSourceProvider(nil); assert(manager:GetStatus().AtlasBytes == 0)
    object:Destroy(); assert(#manager.Records == 0)
    root:Destroy(); manager:Destroy(); assert(manager.Destroyed)
    Instance.NoShadow = false
end)
test('changing source pixels changes rendered output without replacing the atlas', function()
    local root, manager = setup()
    manager:Attach(frame(root))
    local current = source()
    manager:SetSourceProvider(function() return current end); manager:Step()
    local atlas = manager.Atlas
    local first = buffer.tostring(atlas.Pixels)
    buffer.fill(current.Pixels, 0, 220)
    manager:Step()
    assert(manager.Atlas == atlas and buffer.tostring(atlas.Pixels) ~= first)
    manager:Destroy()
end)
test('budget cap, source coverage and reduced transparency degrade without rendering garbage', function()
    local root, manager = setup({TileSize = 16, MaxSurfaces = 1, ReducedTransparency = true})
    local a, b = frame(root), frame(root, 200)
    manager:Attach(a); manager:Attach(b); manager:SetSourceProvider(source); manager:Step()
    assert(manager:GetStatus().RenderedSurfaces == 0 and manager:GetStatus().AtlasBytes == 0)
    assert(a.BackgroundTransparency == 0.08)
    manager.ReducedTransparency = false; manager:Step()
    assert(manager:GetStatus().RenderedSurfaces == 1)
    a.AbsolutePosition = Vector2.new(-10, 0); manager:Step()
    assert(manager:GetStatus().RenderedSurfaces == 0)
    manager:Destroy()
end)
test('external property edits survive detach and manager cannot restart after destruction', function()
    local root, manager = setup()
    local object = frame(root)
    manager:Attach(object); manager:Step()
    object.BackgroundTransparency = 0.35
    manager:Step(); manager:Detach(object)
    assert(object.BackgroundTransparency == 0.35)
    manager:Destroy()
    assert(not pcall(function() manager:SetSourceProvider(source) end))
    assert(not pcall(function() manager:Attach(object) end))
end)
test('invalid allocation settings fail before connecting the renderer', function()
    local root = Instance.new('ScreenGui')
    for _, config in ipairs({{TileSize = 1024}, {MaxSurfaces = 0}, {UpdateHz = 0/0},
        {TileSize = 256, MaxSurfaces = 16}}) do
        assert(not pcall(Glass.newManager, root, config))
    end
    root:Destroy()
end)
print(string.format('%d tests passed (mocked API; engine visuals require Studio).', passed))
